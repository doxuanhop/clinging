/* Shared UI layer inspired by VocalIsolate Studio. */
QWidget { color: #D8DCE0; }
QMainWindow, #RootWindow, #HomePage, #MainWindowEditor { background: #141618; }

QToolTip {
    background: #2A2A2A; color: #EAEAEA;
    border: 1px solid #40E0D0; border-radius: 6px; padding: 5px 8px;
}

QPushButton, QToolButton {
    background-color: #202225; border: 1px solid #383B40;
    color: #D8DCE0; border-radius: 7px;
}
QPushButton:hover, QToolButton:hover {
    background-color: #272A2E; border-color: #40E0D0;
}
QPushButton:pressed, QToolButton:pressed { background-color: #181A1C; }
QPushButton:disabled, QToolButton:disabled {
    background-color: #1A1C1F; border-color: #292C30; color: #62686E;
}

QProgressBar {
    background-color: #25282C; border: 1px solid #34383D;
    border-radius: 4px; text-align: center; color: #D8DCE0;
}
QProgressBar::chunk { background-color: #40E0D0; border-radius: 3px; }
#ExportButton, #ExportDropdown, #NewProjectBtn, #NewProjectDropdown, #PlayBtnMain,
QPushButton#PrimaryButton, QPushButton#Primary {
    background-color: #2C6E64; border: 1px solid #40E0D0;
    color: #EAFFFB; font-weight: 600;
}
#ExportButton:hover, #ExportDropdown:hover, #NewProjectBtn:hover, #NewProjectDropdown:hover,
#PlayBtnMain:hover, QPushButton#PrimaryButton:hover, QPushButton#Primary:hover {
    background-color: #348175;
}
#ExportButton:pressed, #ExportDropdown:pressed, #NewProjectBtn:pressed, #NewProjectDropdown:pressed,
#PlayBtnMain:pressed { background-color: #245A52; }

#NewProjectBtn { border-top-right-radius: 0px; border-bottom-right-radius: 0px; }
#NewProjectDropdown {
    border-left: 1px solid rgba(234,255,251,0.22);
    border-top-left-radius: 0px; border-bottom-left-radius: 0px;
    min-width: 38px; max-width: 38px; padding-left: 0px; padding-right: 0px;
}
#ExportButton { border-top-right-radius: 0px; border-bottom-right-radius: 0px; }
#ExportDropdown {
    border-left: 1px solid rgba(234,255,251,0.22);
    border-top-left-radius: 0px; border-bottom-left-radius: 0px;
}

#VersionBadge, #BetaBadge {
    background-color: #18312E; color: #6AEBD9;
}
#SidebarButton:checked, #TimelineIconBtn:hover, #IconGhostBtn:hover,
#ViewToggleBtn:hover, #CustomSizeBtn:hover {
    background-color: rgba(64, 224, 208, 0.12);
    border-color: #40E0D0; color: #40E0D0;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #40E0D0;
}
QSlider::sub-page:horizontal, QSlider::handle:horizontal { background: #40E0D0; }

QMenu {
    background-color: #232323; color: #D8DCE0;
    border: 1px solid #3A3A3A; border-radius: 9px;
    padding: 6px;
}
QMenu::item {
    background: transparent; padding: 8px 30px 8px 12px;
    border-radius: 6px; margin: 1px 0;
}
QMenu::item:selected {
    background-color: rgba(64, 224, 208, 0.16); color: #EAFFFB;
}
QMenu::item:checked { color: #40E0D0; font-weight: 600; }
QMenu::item:disabled { color: #62686E; }
QMenu::separator { height: 1px; background: #3A3A3A; margin: 6px 4px; }
QMenu::right-arrow {
    image: url(styles/chevron-right.svg); width: 12px; height: 12px;
    margin-right: 7px;
}

QComboBox {
    background-color: #1D1D1D; border: 1px solid #333333;
    border-radius: 8px; padding: 6px 30px 6px 10px;
}
QComboBox:hover, QComboBox:on { border-color: #40E0D0; background: #222222; }
QComboBox QAbstractItemView {
    background: #1D1D1D; color: #D8DCE0; border: 1px solid #3A3A3A;
    padding: 4px; selection-background-color: rgba(64, 224, 208, 0.18);
}

QDialog { background-color: #1A1C1F; }

/* Wheel/touchpad vẫn cuộn, nhưng thanh cuộn không chiếm không gian. */
QScrollBar:vertical, QScrollBar:horizontal {
    width: 0px; height: 0px; background: transparent;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: transparent; }
